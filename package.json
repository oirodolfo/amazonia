{
  "name": "@curupira-labs/amazonia",
  "version": "38.0.0",
  "private": false,
  "description": "Curupira Workbench v11: brutal incremental Electron + Web product build with typed runtime channels, xterm shell tabs, command execution, session restore and local persistence.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch src/server/web-server.ts",
    "dev:electron": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 tsx src/main/main.ts\"",
    "build": "tsc -p tsconfig.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "scan:repo": "tsx scripts/scan-repository.ts",
    "dev:full": "concurrently -k \"pnpm dev:server\" \"pnpm dev:electron\"",
    "validate:zip": "pnpm typecheck && pnpm test",
    "validate:artifact": "tsx scripts/validate-artifact.ts",
    "dev:desktop": "pnpm dev:electron",
    "dev:product": "concurrently -k \"pnpm dev:server\" \"pnpm dev:electron\"",
    "test:v11": "vitest run tests/runtime-mode.test.ts tests/terminal-command.test.ts tests/websocket-protocol.test.ts tests/workbench-state.test.ts",
    "server": "tsx src/server/workbench-server.ts",
    "validate": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@radix-ui/react-hover-card": "latest",
    "@radix-ui/react-slot": "latest",
    "@tailwindcss/vite": "^4.2.4",
    "@xterm/addon-attach": "latest",
    "@xterm/addon-clipboard": "latest",
    "@xterm/addon-fit": "latest",
    "@xterm/addon-image": "latest",
    "@xterm/addon-ligatures": "latest",
    "@xterm/addon-progress": "latest",
    "@xterm/addon-search": "latest",
    "@xterm/addon-serialize": "latest",
    "@xterm/addon-unicode-graphemes": "latest",
    "@xterm/addon-unicode11": "latest",
    "@xterm/addon-web-fonts": "latest",
    "@xterm/addon-web-links": "latest",
    "@xterm/addon-webgl": "latest",
    "@xterm/xterm": "latest",
    "better-sqlite3": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "cmdk": "latest",
    "drizzle-orm": "latest",
    "lucide-react": "latest",
    "node-pty": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-resizable-panels": "latest",
    "tailwind-merge": "latest",
    "tailwindcss-animate": "latest",
    "vite": "latest",
    "ws": "latest",
    "yaml": "latest"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/css": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "eslint": "^10.3.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.59.2",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "exports": {
    ".": "./src/shared/index.ts",
    "./workspace": "./src/workspace/index.ts",
    "./runs": "./src/runs/index.ts",
    "./output": "./src/output/index.ts",
    "./terminal": "./src/terminal/index.ts",
    "./editor": "./src/editor/index.ts",
    "./persistence": "./src/persistence/index.ts",
    "./timeline": "./src/timeline/index.ts",
    "./intelligence": "./src/intelligence/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./terminal-ui": "./src/renderer/components/terminal/index.tsx"
  }
}
